#!/usr/bin/python3 -E
"""Restricted hardware commands exposed to the local desktop session."""
import subprocess
import sys

import nitro

if sys.argv[1:] == ["--protocol-version"]:
    print(nitro.HELPER_API_VERSION)
    sys.exit(0)

if len(sys.argv) < 2 or sys.argv[1] not in {"profile", "firmware", "gpu-power"}:
    if len(sys.argv) < 3 or sys.argv[1] != "fan" or sys.argv[2] not in {"set", "pwm-max", "pwm-set"}:
        sys.exit("Unsupported Nitro Control helper command.")

try:
    nitro.main()
except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
    sys.exit(f"nitro: {error}")
