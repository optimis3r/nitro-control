#!/usr/bin/python3 -E
"""Restricted hardware commands exposed to the local desktop session."""
import subprocess
import sys

import nitro

if len(sys.argv) < 2 or sys.argv[1] not in {"mode", "profile", "firmware", "gpu-power"}:
    if len(sys.argv) < 3 or sys.argv[1] != "fan" or sys.argv[2] not in {"pwm-max", "pwm-set"}:
        sys.exit("Unsupported Nitro Control helper command.")

try:
    nitro.main()
except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
    sys.exit(f"nitro: {error}")
